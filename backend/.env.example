# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── Aplicação ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Docker local:
DATABASE_URL=postgresql://isa:isa@localhost:5435/isa
# Usada pelas migrations (sem pooler na frente):
DIRECT_URL=postgresql://isa:isa@localhost:5435/isa
# PostgreSQL local (seu PC, sem Docker):
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/isa
#
# Em produção, adicione ?connection_limit=N&pool_timeout=N à DATABASE_URL —
# sem isso o Prisma usa um default baixo (num_cpus*2+1) por instância, bem
# abaixo do max_connections do Postgres. Dimensione N por instância como
# (max_connections do servidor * 0.8) / número de instâncias do App Service.

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Webhooks ───────────────────────────────────────────────────────────────────
# Permite cadastrar URLs privadas/localhost como destino de webhooks de saída.
# Use true apenas em desenvolvimento (para testar com serviços locais).
WEBHOOKS_ALLOW_PRIVATE_URLS=true

# Provisionamento generico de webhooks por infraestrutura.
# Exemplo:
# WEBHOOK_BOOTSTRAP_ENDPOINTS=[{"name":"Power Automate","url":"https://example.com/webhook","secret":"whsec_x","events":["ticket.created","ticket.updated"]}]
WEBHOOK_BOOTSTRAP_ENDPOINTS=

# ── E-mail (Azure Communication Services) ──────────────────────────────────────
# Connection string do recurso ACS no Azure Portal
AZURE_COMMUNICATION_CONNECTION_STRING=
# Endereço remetente configurado no ACS (deve ser um domínio verificado no recurso)
AZURE_EMAIL_SENDER=
PORTAL_URL=http://localhost:5173
# Prévia de link (Open Graph): hosts aceitos no X-Forwarded-Host; ".dominio" = sufixo.
# LINK_PREVIEW_ALLOWED_HOSTS=portal.example.org,.example.com

# ── Regras de negócio ──────────────────────────────────────────────────────────
# Horário comercial para cálculo de SLA (24h format)
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
BUSINESS_TIMEZONE=America/Sao_Paulo

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Azure Blob Storage (anexos) ────────────────────────────────────────────────
# Se vazio, anexos continuam em base64 no banco (modo legado).
# A chave fica nos secrets do Container App em produção — nunca commitar.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=ticket-attachments

# ── SSO OIDC multi-tenant (Azure AD / Entra ID) ────────────────────────────────
# Opcional — deixe em branco para desativar
AZURE_AD_CLIENT_ID=
OIDC_CALLBACK_URL=
AZURE_AD_CERT=
AZURE_AD_PRIVATE_KEY=

# IA — agentes em backend/src/ai (Azure OpenAI / Foundry). Sem endpoint/chave a IA fica desligada.
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT=gpt-4.1-mini
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_AI_API_VERSION=2024-10-21
AZURE_AI_TIMEOUT_MS=15000
AZURE_AI_MAX_CONCURRENCY=6
# off | shadow (só sugere em nota interna) | apply (grava no chamado o que passou no limiar)
AI_TRIAGE_MODE=off
AI_INTAKE_MODE=off
AI_GUIDANCE_MODE=off
# Campos que o modo apply grava (type,priority,category,subcategory); o resto vira sugestão na nota
AI_TRIAGE_APPLY_FIELDS=type,priority,category,subcategory
# Assistente de chamados (Teams/portal/MCP): mensagens por usuário na janela (minutos), teto de tokens por conversa
# e alerta só em log do consumo diário de tokens (0 = sem alerta)
AI_ASSISTANT_RATE_LIMIT=20
AI_ASSISTANT_RATE_WINDOW_MIN=5
AI_ASSISTANT_MAX_CONVERSATION_TOKENS=50000
AI_ASSISTANT_DAILY_TOKEN_ALERT=0
