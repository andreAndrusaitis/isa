# Ambiente da suíte integrada (backend/e2e/run-integration.sh).
#
# Só valores FICTÍCIOS. Este arquivo é carregado no lugar do backend/.env
# (DOTENV_CONFIG_PATH), então nenhuma credencial real chega ao processo: sem
# ACS/Graph não sai e-mail, sem blob os anexos ficam no banco e sem AZURE_AD_* não
# há SSO.
#
# Não coloque segredo real aqui: o arquivo é versionado.

NODE_ENV=production

JWT_SECRET=integracao-fake-jwt-secret-nao-usar-em-producao-0001
JWT_REFRESH_SECRET=integracao-fake-refresh-secret-nao-usar-em-producao-0002

MAIL_INBOUND_ENABLED=false
TEAMS_BOT_ENABLED=false

# Foundry de mentira (e2e/foundry-stub.mjs): a IA conta como configurada, mas nada sai
# da máquina e todo agente segue off. Só o 23-base-conhecimento liga o knowledge, pelo
# Motor IA. O run-integration.sh troca a porta quando IT_AI_PORT muda.
AZURE_AI_ENDPOINT=http://127.0.0.1:3023
AZURE_AI_KEY=integracao-fake-foundry-key
AI_TRIAGE_MODE=off
AI_INTAKE_MODE=off
AI_GUIDANCE_MODE=off
