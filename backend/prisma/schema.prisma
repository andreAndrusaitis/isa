  sort_by    String?
  position   Int            @default(0)
  created_by String
  created_at DateTime       @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  creator User    @relation("CustomViewCreatedBy", fields: [created_by], references: [id])

  @@map("project_custom_views")
}

model ProjectWebhook {
  id          String   @id @default(uuid())
  name        String
  description String?
  url         String
  secret      String
  events      String[]
  active      Boolean  @default(true)
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  creator    User                     @relation("ProjectWebhookCreatedBy", fields: [created_by], references: [id])
  deliveries ProjectWebhookDelivery[]
  // Sem nenhuma linha aqui = webhook global (recebe eventos de todos os
  // projetos, presentes e futuros) — mesma semântica que project_id null
  // tinha antes, só que agora suporta selecionar VÁRIOS projetos em vez de
  // no máximo um.
  projects   ProjectWebhookProject[]

  @@index([active])
  @@map("project_webhooks")
}

model ProjectWebhookProject {
  webhook_id String
  project_id String

  webhook ProjectWebhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@id([webhook_id, project_id])
  @@index([project_id])
  @@map("project_webhook_projects")
}

// Chave da API de Projetos (/api/integrations/v1/projects). Age como um usuário
// de serviço próprio (o histórico mostra "API · <nome>"); sem projetos = todos
// (só admin cria), com a mesma regra de dono dos webhooks do módulo.
model ProjectApiKey {
  id              String    @id @default(uuid())
  name            String
  description     String?
  key_hash        String    @unique
  key_prefix      String
  scopes          String[]
  active          Boolean   @default(true)
  created_by      String
  service_user_id String    @unique
  last_used_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  creator      User                   @relation("ProjectApiKeyCreatedBy", fields: [created_by], references: [id])
  service_user User                   @relation("ProjectApiKeyServiceUser", fields: [service_user_id], references: [id])
  projects     ProjectApiKeyProject[]
  requests     ApiRequestLog[]

  @@map("project_api_keys")
}

model ProjectApiKeyProject {
  api_key_id String
  project_id String

  api_key ProjectApiKey @relation(fields: [api_key_id], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@id([api_key_id, project_id])
  @@index([project_id])
  @@map("project_api_key_projects")
}

model ProjectWebhookDelivery {
  id              String                @id @default(uuid())
  webhook_id      String
  event_id        String // evt_... idempotencia
  event           String
  payload         Json
  status          WebhookDeliveryStatus @default(pending)
  attempts        Int                   @default(0)
  next_retry_at   DateTime?
  response_status Int?
  response_body   String?
  error_message   String?
  duration_ms     Int?
  delivered_at    DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  webhook ProjectWebhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([status, next_retry_at])
  @@index([webhook_id, created_at])
  @@map("project_webhook_deliveries")
}

// Conversa do bot do Teams: referência para mensagens proativas, histórico
// curto (últimas N mensagens) e a escrita pendente aguardando confirmação.
model TeamsConversation {
  id                     String    @id @default(uuid())
  user_id                String?
  tenant_id              String
  aad_object_id          String
  conversation_id        String    @unique
  service_url            String
  conversation_reference Json
  history                Json      @default("[]")
  pending_action         Json?
  tokens_used            Int       @default(0)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  last_message_at        DateTime?

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([tenant_id])
  @@map("teams_conversations")
}

enum KnowledgeArticleStatus {
  draft
  published
}

enum AiInteractionFeedback {
  useful
  not_useful
}

// Artigo da base de conhecimento. O acesso segue empresa, plano e categoria:
// artigo sem categoria não aparece para ninguém, por isso publicar exige ao menos uma.
model KnowledgeArticle {
  id              String                 @id @default(uuid())
  title           String
  content         String
  status          KnowledgeArticleStatus @default(draft)
  source_filename String?
  created_by_id   String
  updated_by_id   String
  published_at    DateTime?
  deleted_at      DateTime?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  created_by User                       @relation("KnowledgeArticleCreatedBy", fields: [created_by_id], references: [id])
  updated_by User                       @relation("KnowledgeArticleUpdatedBy", fields: [updated_by_id], references: [id])
  categories KnowledgeArticleCategory[]
  chunks     KnowledgeChunk[]

  @@index([status, deleted_at])
  @@map("knowledge_articles")
}

model KnowledgeArticleCategory {
  id          String   @id @default(uuid())
  article_id  String
  category_id String
  created_at  DateTime @default(now())

  article  KnowledgeArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([article_id, category_id])
  @@index([category_id])
  @@map("knowledge_article_categories")
}

// Trecho do artigo usado na busca vetorial (text-embedding-3-small, 1536 dimensões).
// Prisma não lê nem grava `embedding`: use SQL cru. Índice HNSW feito à mão apareceria
// como DROP em migrate diff e db push, porque o schema não sabe representá-lo.
model KnowledgeChunk {
  id         String                       @id @default(uuid())
  article_id String
  position   Int
  text       String
  embedding  Unsupported("vector(1536)")?
  created_at DateTime                     @default(now())
  updated_at DateTime                     @updatedAt

  article KnowledgeArticle @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@unique([article_id, position])
  @@map("knowledge_chunks")
}

// Pergunta feita à IA e o que ela respondeu. ticket_id é opcional porque a sugestão
// acontece antes do chamado existir; SetNull porque a lixeira expurga o chamado com
// DELETE e a interação precisa continuar nos relatórios.
model AiInteraction {
  id         String                 @id @default(uuid())
  ticket_id  String?
  user_id    String
  org_id     String?
  question   String
  answer     String?
  confidence Float?
  /// Artigos usados na resposta.
  sources    Json                   @default("[]")
  feedback   AiInteractionFeedback?
  accepted   Boolean                @default(false)
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt

  ticket Ticket?       @relation(fields: [ticket_id], references: [id], onDelete: SetNull)
  user   User          @relation(fields: [user_id], references: [id])
  org    Organization? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([user_id, created_at])
  @@index([org_id, created_at])
  @@index([ticket_id])
  @@map("ai_interactions")
}

// ── Documentos: espaços, páginas aninhadas e edição em tempo real (Yjs) ──────

enum DocSpaceVisibility {
  private
  internal
}

enum DocSpaceRole {
  owner
  editor
  viewer
}

model DocSpace {
  id            String             @id @default(uuid())
  name          String
  icon          String?
  color         String?
  description   String?
  /// internal: quem tem o módulo lê; editar continua sendo só de membros.
  visibility    DocSpaceVisibility @default(private)
  created_by_id String?
  archived_at   DateTime?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  created_by User?            @relation("DocSpaceCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  members    DocSpaceMember[]
  pages      DocPage[]

  @@map("doc_spaces")
}

model DocSpaceMember {
  id         String       @id @default(uuid())
  space_id   String
  user_id    String
  role       DocSpaceRole @default(viewer)
  created_at DateTime     @default(now())

  space DocSpace @relation(fields: [space_id], references: [id], onDelete: Cascade)
  user  User     @relation("DocSpaceMemberUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([space_id, user_id])
  @@index([user_id])
  @@map("doc_space_members")
}

model DocPage {
  id            String    @id @default(uuid())
  space_id      String
  parent_id     String?
  title         String    @default("Sem título")
  icon          String?
  position      Float     @default(0)
  /// Estado Yjs (binário). Nunca vai em JSON: só pelo tempo real e em /versions/:id/ydoc.
  ydoc          Bytes?
  /// Texto extraído do ydoc, para a busca.
  content_text  String    @default("")
  revision      Int       @default(0)
  created_by_id String?
  updated_by_id String?
  deleted_at    DateTime?
  deleted_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  space       DocSpace         @relation(fields: [space_id], references: [id], onDelete: Cascade)
  parent      DocPage?         @relation("DocPageTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children    DocPage[]        @relation("DocPageTree")
  created_by  User?            @relation("DocPageCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  updated_by  User?            @relation("DocPageUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)
  deleted_by  User?            @relation("DocPageDeletedBy", fields: [deleted_by_id], references: [id], onDelete: SetNull)
  versions    DocPageVersion[]
  favorites   DocFavorite[]
  attachments DocAttachment[]

  @@index([space_id, parent_id, position])
  @@index([parent_id])
  @@index([deleted_at])
  @@index([space_id, updated_at])
  @@map("doc_pages")
}

model DocPageVersion {
  id            String   @id @default(uuid())
  page_id       String
  /// Título da página no momento da versão.
  title         String
  /// Nome dado por quem salvou; null = versão automática.
  label         String?
  ydoc          Bytes
  created_by_id String?
  created_at    DateTime @default(now())

  page       DocPage @relation(fields: [page_id], references: [id], onDelete: Cascade)
  created_by User?   @relation("DocPageVersionCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([page_id, created_at])
  @@map("doc_page_versions")
}

model DocFavorite {
  user_id    String
  page_id    String
  created_at DateTime @default(now())

  user User    @relation("DocFavoriteUser", fields: [user_id], references: [id], onDelete: Cascade)
  page DocPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@id([user_id, page_id])
  @@index([page_id])
  @@map("doc_favorites")
}

model DocAttachment {
  id            String   @id @default(uuid())
  page_id       String
  /// Espaço atual da página (acompanha a mudança de espaço).
  space_id      String
  filename      String
  mime          String
  size          Int
  /// Nome do blob ou data URI, como services/uploads guarda.
  storage_key   String
  created_by_id String?
  created_at    DateTime @default(now())

  page       DocPage @relation(fields: [page_id], references: [id], onDelete: Cascade)
  created_by User?   @relation("DocAttachmentCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([page_id])
  @@index([space_id])
  @@map("doc_attachments")
}
