  actor User @relation("TaskActivityActor", fields: [actor_id], references: [id])

  @@map("task_activities")
}

model TaskAssignee {
  id      String @id @default(uuid())
  task_id String
  user_id String

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
