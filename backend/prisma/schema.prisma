generator client {
  provider        = "prisma-client-js"
  engineType      = "binary"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  agent
  supervisor
  manager
  admin
}

enum AuthProvider {
  local
  microsoft
}

// Tier enum removed to support dynamic tiers

enum TicketStatus {
  open
  in_progress
  pending
  resolved
  closed
}

/// Canal por onde o chamado entrou. Null = aberto antes do registro ("Não identificado").
enum TicketChannel {
  portal
  email
  api
  teams
  copilot
}

enum TicketPendingReason {
  pending_user
  pending_vendor
  pending_approval
  pending_parts
  pending_schedule
  /// Chamado vinculado a uma task de projeto: SLA pausado, vale o prazo da task.
  pending_project
}

enum TicketType {
  incident
  request
  problem
  change
}

enum TicketPriority {
  low
  medium
  high
}

enum MessageType {
  user
  agent
  email
  internal
}

enum NotificationType {
  new_message
  new_attachment
  ticket_assigned
  ticket_queue_moved
  new_ticket
  ticket_redirected
  ticket_schedule_reopened
  routing_alert
  task_updated
  project_forecast
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  domains            String[]
  authorized_domains AuthorizedDomain[]
  tier               String             @default("bronze")
  active             Boolean            @default(true)
  manager_global     Boolean            @default(false)
  address            String?
  phone              String?
  notes              String?
  location           String?
  zip_code           String?
  website            String?
  expires_at         DateTime?
  expiry_message     String?
  warning_active     Boolean            @default(true)
  /// Cliente pode responder por e-mail os e-mails de chamado (a resposta entra no chamado).
  email_reply_enabled Boolean           @default(false)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  deleted_at         DateTime?
  users              User[]
  tickets            Ticket[]
  queues             Queue[]            @relation("OrganizationQueues")
  queue_access       OrgQueueAccess[]
  manager_links      OrgManagerLink[]
  org_scopes         UserOrgScope[]
  category_blocks    OrgCategoryBlock[]
  ai_interactions    AiInteraction[]
  sla_config         SlaConfig?         @relation(fields: [tier], references: [tier])

  @@map("organizations")
}

model User {
  id                       String                  @id @default(uuid())
  name                     String
  email                    String                  @unique
  password                 String?
  auth_provider            AuthProvider            @default(local)
  must_change_password     Boolean                 @default(false)
  role                     Role                    @default(user)
  avatar                   String?
  queues                   String[]
  permissions              String[]                @default([])
  module_tickets           Boolean?
  module_projects          Boolean?
  module_documents         Boolean?
  my_tasks_columns         Json?
  active                   Boolean                 @default(true)
  // Usuário técnico de uma chave da API de Projetos: não faz login nem aparece na gestão de usuários.
  is_service_account       Boolean                 @default(false)
  manager_global           Boolean                 @default(false)
  org_id                   String?
  position                 String?
  department               String?
  phone                    String?
  location                 String?
  manager_id               String?
  welcome_email_sent_at    DateTime?
  welcome_email_status     String?
  welcome_email_error      String?
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  deleted_at               DateTime?
  session_invalidated_at   DateTime?
  org                      Organization?           @relation(fields: [org_id], references: [id])
  manager                  User?                   @relation("UserToManager", fields: [manager_id], references: [id])
  subordinates             User[]                  @relation("UserToManager")
  tickets_created          Ticket[]                @relation("TicketUser")
  tickets_assigned         Ticket[]                @relation("TicketAgent")
  tickets_opened_on_behalf Ticket[]                @relation("TicketCreator")
  tickets_deleted          Ticket[]                @relation("TicketDeletedBy")
  messages                 TicketMessage[]
  events                   TicketEvent[]
  refresh_tokens           RefreshToken[]
  audit_logs               AuditLog[]
  notifications            Notification[]
  redirect_logs_prev       InactivityRedirectLog[] @relation("PrevAgentRedirect")
  redirect_logs_new        InactivityRedirectLog[] @relation("NewAgentRedirect")
  managed_orgs             OrgManagerLink[]
  org_scopes               UserOrgScope[]
  mcp_tokens               McpToken[]
  macros                   Macro[]                 @relation("MacroCreatedBy")
  ticket_participations    TicketParticipant[]     @relation("ParticipantAgent")
  participants_added       TicketParticipant[]     @relation("ParticipantAddedBy")
  survey_templates_updated SurveyTemplate[]        @relation("TemplateUpdatedBy")
  owned_projects           Project[]               @relation("ProjectOwner")
  sprint_source_projects   Project[]               @relation("ProjectSprintSource")
  global_sprints           GlobalSprint[]          @relation("GlobalSprintOwner")
  project_memberships      ProjectMember[]         @relation("ProjectMemberUser")
  tasks_assigned_projects  Task[]                  @relation("TaskAssignee")
  tasks_created_projects   Task[]                  @relation("TaskCreator")
  task_comments            TaskComment[]           @relation("TaskCommentAuthor")
  task_activities          TaskActivity[]          @relation("TaskActivityActor")
  task_multi_assignments   TaskAssignee[]          @relation("TaskAssigneeMulti")
  documents_created        Document[]              @relation("DocumentCreatedBy")
  documents_updated        Document[]              @relation("DocumentUpdatedBy")
  attachments_uploaded     Attachment[]            @relation("AttachmentUploader")
  mentions_received        Mention[]               @relation("MentionedUser")
  approvals_assigned       Approval[]              @relation("ApprovalApprover")
  templates_created        Template[]              @relation("TemplateCreatedBy")
  automations_created      Automation[]            @relation("AutomationCreatedBy")
  task_watching            TaskWatcher[]           @relation("TaskWatcherUser")
  project_favorites        Favorite[]              @relation("FavoriteUser")
  saved_filters            SavedFilter[]           @relation("SavedFilterUser")
  custom_views_created     CustomView[]            @relation("CustomViewCreatedBy")
  project_webhooks_created ProjectWebhook[]        @relation("ProjectWebhookCreatedBy")
  project_api_keys_created ProjectApiKey[]         @relation("ProjectApiKeyCreatedBy")
  project_api_key_service  ProjectApiKey?          @relation("ProjectApiKeyServiceUser")

  ai_feedback AiFeedback[]
  teams_conversations TeamsConversation[]
  knowledge_articles_created KnowledgeArticle[] @relation("KnowledgeArticleCreatedBy")
  knowledge_articles_updated KnowledgeArticle[] @relation("KnowledgeArticleUpdatedBy")
  ai_interactions AiInteraction[]

  doc_spaces_created       DocSpace[]       @relation("DocSpaceCreatedBy")
  doc_space_memberships    DocSpaceMember[] @relation("DocSpaceMemberUser")
  doc_pages_created        DocPage[]        @relation("DocPageCreatedBy")
  doc_pages_updated        DocPage[]        @relation("DocPageUpdatedBy")
  doc_pages_deleted        DocPage[]        @relation("DocPageDeletedBy")
  doc_page_versions        DocPageVersion[] @relation("DocPageVersionCreatedBy")
  doc_favorites            DocFavorite[]    @relation("DocFavoriteUser")
  doc_attachments          DocAttachment[]  @relation("DocAttachmentCreatedBy")

  @@index([manager_id])
  @@index([org_id])
  @@map("users")
}

model OrgManagerLink {
  id         String       @id @default(uuid())
  org_id     String
  manager_id String
  created_at DateTime     @default(now())
  org        Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  manager    User         @relation(fields: [manager_id], references: [id], onDelete: Cascade)

  @@unique([org_id, manager_id])
  @@map("org_manager_links")
}

model UserOrgScope {
  id      String       @id @default(uuid())
  user_id String
  org_id  String
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([user_id, org_id])
  @@map("user_org_scopes")
}

model AuthorizedDomain {
  id         String       @id @default(uuid())
  domain     String       @unique
  org_id     String
  active     Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  org        Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("authorized_domains")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String // e.g. "LOGIN", "LOGOUT", "UPDATE_TICKET"
  resource   String // e.g. "AUTH", "TICKET", "USER"
  details    Json? // Context about the action
  ip         String?
  user_agent String?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model Queue {
  id            String           @id @default(uuid())
  name          String
  color         String           @default("#0f73ac")
  description   String           @default("")
  active        Boolean          @default(true)
  icon          String?
  image_url     String?
  organizations Organization[]   @relation("OrganizationQueues")
  queue_access  OrgQueueAccess[]

  @@map("queues")
}

model Category {
  id              String             @id @default(uuid())
  name            String
  icon            String             @default("")
  color           String             @default("#0f73ac")
  description     String?
  image_url       String?
  active          Boolean            @default(true)
  subcategories   Subcategory[]
  tickets         Ticket[]
  sla_configs     SlaConfig[]
  plan_categories PlanCategory[]
  org_blocks      OrgCategoryBlock[]
  knowledge_articles KnowledgeArticleCategory[]

  @@map("categories")
}

model Subcategory {
  id                     String                @id @default(uuid())
  name                   String
  category_id            String
  active                 Boolean               @default(true)
  description            String?
  icon                   String?
  image_url              String?
  is_special             Boolean               @default(false)
  special_form_schema    Json?
  special_title_template String?
  category               Category              @relation(fields: [category_id], references: [id])
  tickets                Ticket[]
  intake_items           IntakeChecklistItem[]

  @@map("subcategories")
}

// Macros: respostas pré-definidas cadastradas por Admin/Gerente e usadas
// pelos analistas no chat do chamado. Globais (sem vínculo a fila/categoria).
// Não há exclusão — apenas desativação via `active`.
model Macro {
  id            String   @id @default(uuid())
  title         String
  content       String
  active        Boolean  @default(true)
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    User?    @relation("MacroCreatedBy", fields: [created_by_id], references: [id])

  @@map("macros")
}

model Ticket {
  id                      String                      @id
  title                   String
  description             String?
  special_data            Json?
  status                  TicketStatus                @default(open)
  priority                TicketPriority              @default(medium)
  type                    TicketType                  @default(incident)
  display_number          String                      @unique
  queue                   String?
  category_id             String?
  subcategory_id          String?
  user_id                 String
  created_by_id           String?
  org_id                  String?
  assigned_to_id          String?
  /// Primeira vez que o chamado ganhou responsável (trigger no banco; não usar para o responsável atual).
  first_assigned_at       DateTime?
  collab_queue            String?
  sla_deadline            DateTime
  first_response_deadline DateTime?
  escalated               Boolean                     @default(false)
  is_reopened             Boolean                     @default(false)
  resolution_details      String?
  resolved_at             DateTime?
  closed_at               DateTime?
  attachment_url          String?
  auto_redirected         Boolean                     @default(false)
  redirected_at           DateTime?
  chat_enabled            Boolean                     @default(false)
  reopen_sla_enabled      Boolean?
  reopen_sla_limit_hours  Int?
  sla_paused_at           DateTime?
  total_paused_minutes    Int                         @default(0)
  pending_reason          TicketPendingReason?
  pending_schedule_at     DateTime?
  /// Nova previsão combinada com o cliente; ele vê esta data no lugar do prazo do plano.
  client_forecast_at      DateTime?
  /// Agente intake: null | complete | incomplete | complemented | dismissed | skipped
  intake_status           String?
  /// Agente guidance: null | offered | deflected | declined | duplicate_offered | linked | skipped | none
  guidance_status         String?
  /// Canal de origem; null nos chamados anteriores ao registro.
  channel                 TicketChannel?
  /// Segundos entre abrir o formulário do portal e enviar; só no portal.
  opening_seconds         Int?
  /// Resolvido pela IA sem passar pela fila; reaberto, a marca sai e o chamado entra no fluxo normal.
  ai_resolved             Boolean                     @default(false)
  created_at              DateTime                    @default(now())
  updated_at              DateTime                    @updatedAt
  deleted_at              DateTime?
  deleted_by_id           String?
  /// Task de projeto que absorveu o chamado (ponte chamado ↔ task). Vários chamados → 1 task.
  project_task_id         String?
  project_forecast_alerted_at DateTime?
  user                    User                        @relation("TicketUser", fields: [user_id], references: [id])
  deleted_by              User?                       @relation("TicketDeletedBy", fields: [deleted_by_id], references: [id], onDelete: SetNull)
  project_task            Task?                       @relation("TicketProjectTask", fields: [project_task_id], references: [id], onDelete: SetNull)
  created_by              User?                       @relation("TicketCreator", fields: [created_by_id], references: [id])
  org                     Organization?               @relation(fields: [org_id], references: [id])
  assigned_to             User?                       @relation("TicketAgent", fields: [assigned_to_id], references: [id])
  category                Category?                   @relation(fields: [category_id], references: [id])
  subcategory             Subcategory?                @relation(fields: [subcategory_id], references: [id])
  messages                TicketMessage[]
  attachments             TicketAttachment[]
  events                  TicketEvent[]
  notifications           Notification[]
  redirect_logs           InactivityRedirectLog[]
  auto_close_logs         AutoCloseLog[]
  participants            TicketParticipant[]
  survey_instance         SurveyInstance?
  ai_agent_runs           AiAgentRun[]
  ai_feedback             AiFeedback[]
  ai_interactions         AiInteraction[]
  links                   TicketLink[]                @relation("TicketLinkFrom")
  linked_from             TicketLink[]                @relation("TicketLinkTo")
  email_logs              EmailLog[]
  inbound_emails          InboundEmail[]

  @@index([deleted_at, status])
  @@index([org_id])
  @@index([queue])
  @@index([assigned_to_id])
  @@index([created_by_id])
  @@index([created_at])
  @@index([channel, created_at])
  @@index([sla_deadline])
  @@index([project_task_id])
  @@map("tickets")
}

// Agentes que atuam em um chamado além do criador. O escalonamento de
// "atuação unificada" (same_ticket) adiciona o agente escalonado como
// participante colaborador, mantendo o chamado único (sem chamado filho).
model TicketParticipant {
  id          String    @id @default(uuid())
  ticket_id   String
  agent_id    String
  role        String    @default("collaborator") // "owner" | "collaborator"
  added_by_id String?
  added_at    DateTime  @default(now())
  removed_at  DateTime?
  active      Boolean   @default(true)
  ticket      Ticket    @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  agent       User      @relation("ParticipantAgent", fields: [agent_id], references: [id])
  added_by    User?     @relation("ParticipantAddedBy", fields: [added_by_id], references: [id])

  @@unique([ticket_id, agent_id])
  @@index([agent_id, active])
  @@map("ticket_participants")
}

model TicketMessage {
  id             String      @id @default(uuid())
  ticket_id      String
  user_id        String
  type           MessageType
  text           String
  attachment_url String?
  is_realtime    Boolean     @default(false)
  created_at     DateTime    @default(now())
  ticket         Ticket      @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [user_id], references: [id])

  @@index([ticket_id, created_at])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticket_id  String
  name       String
  size       String
  type       String
  url        String
  created_at DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

model TicketEvent {
  id                  String               @id @default(uuid())
  ticket_id           String
  user_id             String
  from_status         TicketStatus?
  to_status           TicketStatus
  note                String?
  pending_reason      TicketPendingReason?
  pending_schedule_at DateTime?
  attachment_url      String?
  // Regra de automação que gerou o evento (sem FK: a regra pode ser apagada).
  routing_rule_id     String?
  created_at          DateTime             @default(now())
  ticket              Ticket               @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [user_id], references: [id])

  @@index([routing_rule_id])
  @@map("ticket_events")
}

model Notification {
  id          String           @id @default(uuid())
  user_id     String
  ticket_id   String?
  task_id     String?
  type        NotificationType
  title       String
  body        String
  sender_name String?
  read_at     DateTime?
  created_at  DateTime         @default(now())

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at])
  @@index([ticket_id])
  @@map("notifications")
}

model RoutingRule {
  id              String   @id @default(uuid())
  name            String
  enabled         Boolean  @default(true)
  priority        Int
  conditions      Json
  match_type      String   @default("all")
  actions         Json
  else_actions    Json?
  // Gatilho (catálogo em services/routing.ts). Regras antigas = ticket_created.
  trigger         String   @default("ticket_created")
  trigger_hours   Int? // só para ticket_idle
  stop_processing Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("routing_rules")
}

model SlaConfig {
  id                            String                  @id @default(uuid())
  tier                          String                  @unique
  incident_first_response_hours Int
  incident_resolution_hours     Int
  request_first_response_hours  Int                     @default(8)
  request_resolution_hours      Int                     @default(48)
  problem_first_response_hours  Int                     @default(8)
  problem_resolution_hours      Int                     @default(72)
  change_first_response_hours   Int                     @default(24)
  change_resolution_hours       Int                     @default(120)
  default_queue                 String                  @default("geral")
  escalation_queue              String                  @default("geral")
  escalation_minutes            Int                     @default(30)
  color                         String?
  category_id                   String?
  category                      Category?               @relation(fields: [category_id], references: [id])
  created_at                    DateTime                @default(now())
  updated_at                    DateTime                @updatedAt
  packages                      PlanAdditionalPackage[]
  plan_categories               PlanCategory[]
  orgs                          Organization[]

  @@map("sla_configs")
}

// Catálogo de pacotes adicionais que podem ser alocados a planos (SlaConfig)
// existentes. A criação/gestão deste catálogo está fora do escopo da feature
// 196 — aqui apenas existe a entidade para permitir a alocação aos planos.
model AdditionalPackage {
  id          String                  @id @default(uuid())
  name        String                  @unique
  description String?
  active      Boolean                 @default(true)
  created_at  DateTime                @default(now())
  updated_at  DateTime                @updatedAt
  plans       PlanAdditionalPackage[]

  @@map("additional_packages")
}

model PlanCategory {
  id            String    @id @default(uuid())
  sla_config_id String
  category_id   String
  created_at    DateTime  @default(now())
  sla_config    SlaConfig @relation(fields: [sla_config_id], references: [id], onDelete: Cascade)
  category      Category  @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([sla_config_id, category_id])
  @@map("plan_categories")
}

model BusinessHoursConfig {
  id                   String   @id @default(uuid())
  business_hours_start String   @default("08:00")
  business_hours_end   String   @default("18:00")
  working_days         Int[]    @default([1, 2, 3, 4, 5])
  timezone             String   @default("America/Sao_Paulo")
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("business_hours_config")
}

// Vínculo (alocação) entre um plano (SlaConfig) e um pacote adicional.
// O plano base permanece inalterado; cada registro adiciona um complemento.
model PlanAdditionalPackage {
  id            String            @id @default(uuid())
  sla_config_id String
  package_id    String
  created_at    DateTime          @default(now())
  sla_config    SlaConfig         @relation(fields: [sla_config_id], references: [id], onDelete: Cascade)
  package       AdditionalPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@unique([sla_config_id, package_id])
  @@map("plan_additional_packages")
}

model EscalationRule {
  id                 String   @id @default(uuid())
  name               String
  type               String // 'transfer' | 'child_ticket' | 'same_ticket' | 'category_change'
  target_queue_id    String?
  target_category_id String?
  auto_description   String?
  active             Boolean  @default(true)
  /// 'queue' (fila) | 'agent_pick' (analista escolhido na hora) | 'agent_fixed' (analista fixo)
  target_mode        String   @default("queue")
  target_agent_id    String?
  /// Quem escalonou segue no chamado (transferência) ou acompanha o filho, como colaborador.
  keep_origin        Boolean  @default(false)
  /// Exige justificativa de quem escalona.
  require_note       Boolean  @default(false)
  /// Prioridade aplicada ao escalonar (null = mantém).
  target_priority    String?
  /// Filas em que a regra aparece (vazio = todas).
  source_queue_ids   String[] @default([])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("escalation_rules")
}

model OrgQueueAccess {
  id             String       @id @default(uuid())
  org_id         String
  queue_id       String
  expires_at     DateTime?
  expiry_message String?
  warning_active Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  org            Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  queue          Queue        @relation(fields: [queue_id], references: [id], onDelete: Cascade)

  @@unique([org_id, queue_id])
  @@map("org_queue_access")
}

// Categoria do plano desligada para uma empresa específica. Sem linha = a
// empresa herda a categoria do plano. Habilitar = apagar a linha.
model OrgCategoryBlock {
  id          String       @id @default(uuid())
  org_id      String
  category_id String
  created_at  DateTime     @default(now())
  created_by  String?
  org         Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([org_id, category_id])
  @@map("org_category_blocks")
}

model InactivityRedirectConfig {
  id                    String         @id @default(uuid())
  enabled               Boolean        @default(true)
  inactivity_hours      Int            @default(24)
  business_hours_start  String         @default("08:00")
  business_hours_end    String         @default("18:00")
  working_days          Int[]          @default([1, 2, 3, 4, 5])
  timezone              String         @default("America/Sao_Paulo")
  target_priority       TicketPriority @default(high)
  vip_queue_id          String?
  max_redirects_per_day Int            @default(1)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  @@map("inactivity_redirect_config")
}

// Lixeira de chamados: retenção antes da exclusão definitiva (linha única).
model TrashConfig {
  id             String   @id @default(uuid())
  enabled        Boolean  @default(true)
  retention_days Int      @default(30)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("trash_config")
}

model ReopenSlaConfig {
  id                    String   @id @default(uuid())
  enabled               Boolean  @default(true)
  reopen_limit_hours    Int      @default(24)
  reopen_deadline_rule  String   @default("org_sla")
  reopen_deadline_hours Int      @default(8)
