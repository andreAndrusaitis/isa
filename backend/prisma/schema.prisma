  task_overdue
  task_completed
  subtasks_completed
  priority_changed
  approval_decided
  comment_created
}

enum AutomationActionType {
  change_status
  change_assignee
  change_priority
  add_tag
  create_subtask
  send_notification
  request_approval
  move_list
  add_comment
}

model Automation {
