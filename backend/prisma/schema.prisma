model Project {
  id                       String         @id @default(uuid())
  name                     String
  description              String?
  privacy                  ProjectPrivacy @default(organization)
  owner_id                 String
  next_task_seq            Int            @default(1)
  allow_multiple_assignees Boolean        @default(false)
  /// Cor de identidade (#rrggbb): pasta na sidebar e destaques dentro do projeto. Null = cor padrão do tema.
  color                    String?
  start_date               DateTime?
  target_date              DateTime?
  /// Origem dos sprints: null = sprints próprios; id de um Gerente = segue o calendário global dele.
  sprint_source_id         String?
  /// Pasta da sidebar (árvore compartilhada de organização dos projetos).
  nav_folder_id            String?
  archived_at              DateTime?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt

  owner         User                    @relation("ProjectOwner", fields: [owner_id], references: [id])
  sprint_source User?                   @relation("ProjectSprintSource", fields: [sprint_source_id], references: [id], onDelete: SetNull)
  nav_folder    ProjectNavFolder?       @relation(fields: [nav_folder_id], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  folders       ProjectFolder[]
  lists         ProjectList[]
  statuses      ProjectStatus[]
  task_types    TaskType[]
  sprints       Sprint[]
  tasks         Task[]
  custom_fields CustomField[]
  tags          Tag[]
  documents     Document[]
  attachments   Attachment[]
  automations   Automation[]
  webhooks      ProjectWebhookProject[]
  api_keys      ProjectApiKeyProject[]
  favorites     Favorite[]
  saved_filters SavedFilter[]
  custom_views  CustomView[]

  @@map("projects")
}

model ProjectMember {
  id         String            @id @default(uuid())
  project_id String
  user_id    String
  role       ProjectMemberRole @default(member)
  created_at DateTime          @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@map("project_members")
}

model ProjectFolder {
  id          String    @id @default(uuid())
  project_id  String
  name        String
  position    Int       @default(0)
  archived_at DateTime?
  created_at  DateTime  @default(now())

  project Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  lists   ProjectList[]

  @@map("project_folders")
}

model ProjectList {
  id          String    @id @default(uuid())
  project_id  String
  folder_id   String?
  name        String
  description String?
  position    Int       @default(0)
  archived_at DateTime?
  created_at  DateTime  @default(now())

  project Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  folder  ProjectFolder? @relation(fields: [folder_id], references: [id])
  tasks   Task[]

  @@map("project_lists")
}

model ProjectStatus {
  id                String         @id @default(uuid())
  project_id        String
  name              String
  color             String
  category          StatusCategory
  position          Int            @default(0)
  is_active         Boolean        @default(true)
  requires_approval Boolean        @default(false)
  wip_limit         Int?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("project_statuses")
}

model TaskType {
  id         String  @id @default(uuid())
  project_id String
  name       String
  icon       String
  color      String
  position   Int     @default(0)
  is_active  Boolean @default(true)
  // Prefixo do ID da task (BUG, FEAT…), único por projeto, e o próximo número
  // desse tipo: as tasks ganham BUG-1, BUG-2… independente do #seq do projeto.
  prefix      String @default("")
  next_number Int    @default(1)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("task_types")
}

enum SprintStatus {
  planned
  active
  completed
}

model Sprint {
  id               String       @id @default(uuid())
  project_id       String
  /// Cópia de um sprint global (mantida em sincronia por services/globalSprints). Null = sprint próprio do projeto.
  global_sprint_id String?
  name             String
  status           SprintStatus @default(planned)
  start_date       DateTime?
  end_date         DateTime?
  position         Int          @default(0)

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  global_sprint GlobalSprint? @relation(fields: [global_sprint_id], references: [id], onDelete: Cascade)
  tasks         Task[]

  @@unique([project_id, global_sprint_id])
  @@map("sprints")
}
model GlobalSprint {
  id         String       @id @default(uuid())
  owner_id   String
  name       String
  status     SprintStatus @default(planned)
  start_date DateTime?
  end_date   DateTime?
  position   Int          @default(0)
  created_at DateTime     @default(now())

  owner   User     @relation("GlobalSprintOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  sprints Sprint[]

  @@index([owner_id])
  @@map("global_sprints")
}

model ProjectNavFolder {
  id         String   @id @default(uuid())
  name       String
  parent_id  String?
  created_at DateTime @default(now())

  parent   ProjectNavFolder?  @relation("NavFolderTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children ProjectNavFolder[] @relation("NavFolderTree")
  projects Project[]

  @@map("project_nav_folders")
}

model Task {
  id           String       @id @default(uuid())
  project_id   String
  list_id      String?
  status_id    String
  parent_id    String?
  task_type_id String?
  sprint_id    String?
  seq          Int
  type_number  Int? // número dentro do tipo (BUG-12 → 12)
  key          String? // chave pronta "BUG-12"; refeita quando o prefixo do tipo muda
  title        String
  description  String?
  priority     TaskPriority @default(none)
  assignee_id  String?
  creator_id   String
  start_date   DateTime?
  due_date     DateTime?
  story_points Int?
  position     Int          @default(0)
  is_milestone Boolean      @default(false)
  recurrence   Json? // { freq: 'daily'|'weekly'|'monthly'|'yearly'|'custom', interval: number, mode: 'on_complete'|'on_due', weekdays?: number[] }
  archived_at  DateTime?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  project             Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  list                ProjectList?       @relation(fields: [list_id], references: [id])
  status              ProjectStatus      @relation(fields: [status_id], references: [id])
  task_type           TaskType?          @relation(fields: [task_type_id], references: [id], onDelete: SetNull)
  sprint              Sprint?            @relation(fields: [sprint_id], references: [id], onDelete: SetNull)
  assignee            User?              @relation("TaskAssignee", fields: [assignee_id], references: [id])
  creator             User               @relation("TaskCreator", fields: [creator_id], references: [id])
  parent              Task?              @relation("TaskSubtasks", fields: [parent_id], references: [id], onDelete: Cascade)
  subtasks            Task[]             @relation("TaskSubtasks")
  checklist           ChecklistItem[]
  comments            TaskComment[]
  activities          TaskActivity[]
  notifications       Notification[]
  multi_assignees     TaskAssignee[]
  dependents          TaskDependency[]   @relation("TaskDependent")
  blocking            TaskDependency[]   @relation("TaskBlocker")
  custom_field_values CustomFieldValue[]
  tags                TaskTag[]
  documents           TaskDocument[]
  approvals           Approval[]
  watchers            TaskWatcher[]
  relations_from      TaskRelation[]     @relation("RelationFrom")
  relations_to        TaskRelation[]     @relation("RelationTo")
  linked_tickets      Ticket[]           @relation("TicketProjectTask")

  @@unique([project_id, seq])
  @@unique([task_type_id, type_number])
  @@index([project_id, archived_at])
  @@index([assignee_id, due_date])
  @@map("tasks")
}

model ChecklistItem {
  id         String   @id @default(uuid())
  task_id    String
  text       String
  done       Boolean  @default(false)
  position   Int      @default(0)
  created_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model TaskComment {
