  unica_escolha // legado
  texto_livre
  escala
  escolha_unica
  escolha_multipla
  nps
}

enum SurveyQuestionStyle {
  emoji
  estrela
  numerico
  pill
}

enum SurveyOptionAction {
  reabrir_chamado
}

enum SurveyInstanceStatus {
  enviada
  respondida
  expirada
}

enum SurveyDispatchChannel {
  email
  chat_auto
  chat_macro
}

enum SurveyDispatchSendStatus {
  enfileirado
  enviado
  falha
}

enum SurveyResolution {
