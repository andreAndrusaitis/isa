  @@map("survey_question_options")
}

model SurveyInstance {
  id            String               @id @default(uuid())
  ticket_id     String               @unique // vínculo 1:1 com chamado
  template_id   String
  link_token    String               @unique
  status        SurveyInstanceStatus @default(enviada)
