}

enum ApprovalStatus {
  pending
  approved
  changes_requested
}

model Approval {
  id          String         @id @default(uuid())
  task_id     String
  approver_id String
  status      ApprovalStatus @default(pending)
  comment     String?
  decided_at  DateTime?
  created_at  DateTime       @default(now())

  task     Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
