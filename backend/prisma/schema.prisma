  enabled Boolean    @default(true)

  @@map("ticket_type_configs")
}

// ============================================================
// Webhooks de saída + API externa (entrada) — configuráveis pelo Admin
// ============================================================

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum ApiRequestStatus {
  received
  processing
  success
  duplicate
  failed
}

model WebhookEndpoint {
  id            String            @id @default(uuid())
  name          String
  url           String
  secret        String // usado para assinar cada envio (HMAC-SHA256); nunca retornado em listagens
  events        String[] // subconjunto de WEBHOOK_EVENTS (lista canônica em código)
  filters       Json? // { types?: string[], priorities?: string[], queues?: string[], org_ids?: string[], category_ids?: string[] }
  active        Boolean           @default(true)
  created_by_id String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  deliveries    WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String                @id @default(uuid())
  endpoint_id     String
  event           String
  payload         Json
  status          WebhookDeliveryStatus @default(pending)
  attempts        Int                   @default(0)
  next_retry_at   DateTime? // null = pronto para a 1ª tentativa
  response_status Int?
  response_body   String? // truncado
  error_message   String?
  duration_ms     Int?
  delivered_at    DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  endpoint        WebhookEndpoint       @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@index([status, next_retry_at])
  @@index([endpoint_id, created_at])
  @@map("webhook_deliveries")
}

model ApiKey {
  id            String          @id @default(uuid())
  name          String
  key_hash      String // sha256 hex da key — a key em si é exibida uma única vez
  key_prefix    String // ex: "isakey_a1b2" para identificação na UI
  scopes        String[] // subconjunto de: create_ticket, update_ticket, create_user, update_user,
  // read_categories, read_subcategories, read_queues, read_organizations, read_tickets
  org_id        String? // preenchido = key travada numa empresa; null = multi-empresa por domínio
  active        Boolean         @default(true)
  created_by_id String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  last_used_at  DateTime?
  requests      ApiRequestLog[]

  @@map("api_keys")
}

model McpToken {
  id           String    @id @default(uuid())
  user_id      String
  name         String
  token_hash   String    @unique
  token_prefix String // ex: "isamcp_a1b2" para identificação na UI
  active       Boolean   @default(true)
  created_at   DateTime  @default(now())
  last_used_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("mcp_tokens")
}

model ApiRequestLog {
  id                  String           @id @default(uuid())
  // Uma das duas: chave da API de chamados ou da API de Projetos.
  api_key_id          String?
  project_api_key_id  String?
  external_request_id String?
  method              String // GET/POST/PATCH
  path                String // ex: "/tickets"
  status              ApiRequestStatus
  request_payload     Json?
  response_status     Int?
  response_payload    Json?
  error_code          String?
  error_message       String?
  resource_type       String? // 'ticket' | 'user'
  resource_id         String?
  ip                  String?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  api_key             ApiKey?          @relation(fields: [api_key_id], references: [id], onDelete: Cascade)
  project_api_key     ProjectApiKey?   @relation(fields: [project_api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, external_request_id])
  @@unique([project_api_key_id, external_request_id])
  @@index([api_key_id, created_at])
  @@index([project_api_key_id, created_at])
  @@map("api_request_logs")
}

// Execuções dos agentes de IA (backend/src/ai). Uma linha por execução de
// qualquer agente ('triage', ...); `result` guarda a decisão completa do agente
// (opções, probabilidades, confiança, evidência) para auditoria e métricas.
model AiAgentRun {
  id             String       @id @default(uuid())
  agent          String
  ticket_id      String?
  mode           String // 'shadow' | 'apply'
  model          String
  prompt_version String
  status         String // 'ok' | 'error'
  error          String?
  latency_ms     Int
  input_tokens   Int          @default(0)
  output_tokens  Int          @default(0)
  result         Json?
  created_at     DateTime     @default(now())
  ticket         Ticket?      @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  feedback       AiFeedback[]

  @@index([agent, created_at])
  @@index([ticket_id])
  @@map("ai_agent_runs")
}

// Correção humana de um campo que a IA decidiu (ex.: analista troca a categoria
// que a triagem escolheu). Guarda o valor da IA, o anterior e o novo, e quem
// corrigiu: base para medir acerto do agente. Guarda a trilha de toda mudança
// humana em campo decidido pela IA; para acerto/reclassificação use a PRIMEIRA
// linha por (run_id, field): as seguintes têm from_value ≠ ai_value.
model AiFeedback {
  id         String     @id @default(uuid())
  run_id     String
  ticket_id  String
  agent      String
  field      String // 'type' | 'category' | 'subcategory' | 'priority'
  ai_value   String?
  ai_label   String?
  from_value String?
  to_value   String?
  user_id    String
  created_at DateTime   @default(now())
  run        AiAgentRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id])

  @@index([run_id])
  @@index([ticket_id])
  @@index([agent, created_at])
  @@map("ai_feedback")
}

// Exemplos rotulados para RAG dos agentes de IA (few-shot por similaridade).
// Fontes: 'backlog' (base antiga rotulada) e 'ticket' (chamados fechados e
// validados por analistas). `text` é o texto mascarado que foi embedado;
// `labels` são os rótulos do agente (triagem: {type, urgency, impact, tema}).
// Embedding em double precision[] + cosseno em memória no Node; trocar por vector(1536) + índice HNSW quando passar de
// alguns milhares de exemplos por agente.
model AiExample {
  id         String   @id @default(uuid())
  agent      String
  source     String // 'backlog' | 'ticket'
  source_id  String
  text       String
  labels     Json
  embedding  Float[]
  /// false = vetado por um analista (👎 na Orientação IA): sai da busca.
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  @@unique([agent, source, source_id])
  @@index([agent])
  @@map("ai_examples")
}

/// Modo de cada agente de IA escolhido em Admin › Motor IA. Sem linha = padrão do env (AI_<AGENTE>_MODE).
/// Configurações do sistema editadas pelo admin: appearance | sso_microsoft | ai_provider.
model SystemSetting {
  key           String   @id
  value         Json     @default("{}")
  /// Só texto cifrado (utils/secretBox.ts); nunca sai pela API.
  secrets       Json     @default("{}")
  updated_by_id String?
  updated_at    DateTime @updatedAt

  @@map("system_settings")
}

model AiAgentSetting {
  agent      String   @id
  mode       String // off | shadow | apply
  /// Configurações do agente no Motor IA (declaradas em agents/registry.ts); null = padrões.
  config     Json?
  updated_at DateTime @updatedAt

  @@map("ai_agent_settings")
}

/// Checklist de informações mínimas na abertura (agente intake). subcategory_id null = vale para o tipo inteiro.
model IntakeChecklistItem {
  id             String       @id @default(uuid())
  type           TicketType
  subcategory_id String?
  key            String
  label          String
  criterion      String
  question       String
  kind           String       @default("text") // text | evidence (imagem anexada cumpre por regra)
  required       Boolean      @default(true) // false = só aparece na nota, nunca vira pergunta
  sort           Int          @default(0)
  active         Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  subcategory    Subcategory? @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)

  @@index([type])
  @@map("intake_checklist_items")
}

/// Vínculo entre chamados. kind 'duplicate': ticket_id (novo) duplica related_id (já aberto).
model TicketLink {
  id            String   @id @default(uuid())
  ticket_id     String
  related_id    String
  kind          String   @default("duplicate")
  created_by_id String
  created_at    DateTime @default(now())
  ticket        Ticket   @relation("TicketLinkFrom", fields: [ticket_id], references: [id], onDelete: Cascade)
  related       Ticket   @relation("TicketLinkTo", fields: [related_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, related_id])
  @@index([related_id])
  @@map("ticket_links")
}

/// Todo e-mail que o sistema tentou enviar (sucesso, falha ou ignorado por falta de ACS).
model EmailLog {
  id         String   @id @default(uuid())
  kind       String // welcome | ticket_created | ticket_update | survey | survey_resend | auto_reply
  recipient  String
  subject    String
  status     String // SUCCESS | FAILED | SKIPPED_ACS_NOT_CONFIGURED
  error      String?
  html       String? // corpo enviado (senha inicial mascarada); nulo em logs antigos
  ticket_id  String?
  /// graph (caixa de atendimento) | acs; nulo em logs antigos
  provider            String?
  /// Message-ID do e-mail enviado pelo Graph: liga a resposta do cliente a este envio.
  internet_message_id String?  @unique
  conversation_id     String?
  /// Enviado convidando a responder (resposta entra no chamado); falso = "[Não responda]".
  replyable           Boolean  @default(false)
  created_at DateTime @default(now())
  ticket     Ticket?  @relation(fields: [ticket_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([ticket_id])
  @@index([conversation_id])
  @@map("email_logs")
}

/// E-mail recebido na caixa de atendimento e o que o ISA fez com ele.
/// A linha é criada antes do processamento: o graph_message_id único impede
/// que as duas instâncias do backend processem a mesma mensagem.
model InboundEmail {
  id                  String    @id @default(uuid())
  graph_message_id    String    @unique
  internet_message_id String?
  from_email          String
  from_name           String?
  subject             String
  received_at         DateTime
  /// processing | ticket_created | message_added | note_added | ignored | failed
  status              String    @default("processing")
  attempts            Int       @default(1)
  /// motivo legível do desfecho (ex.: resposta por e-mail desabilitada, domínio desconhecido)
  detail              String?
  ticket_id           String?
  claimed_at          DateTime  @default(now())
  processed_at        DateTime?
  created_at          DateTime  @default(now())
  ticket              Ticket?   @relation(fields: [ticket_id], references: [id], onDelete: SetNull)

  @@index([received_at])
  @@index([ticket_id])
  @@index([status])
  @@map("inbound_emails")
}

/// Remetentes que não abrem chamado por e-mail/API (spam, avisos automáticos).
/// kind: email (endereço exato) | domain (domínio e subdomínios).
model EmailBlock {
  id            String    @id @default(uuid())
  kind          String
  value         String
  reason        String?
  hits          Int       @default(0)
  last_hit_at   DateTime?
  created_by_id String?
  created_at    DateTime  @default(now())

  @@unique([kind, value])
  @@map("email_blocks")
}

