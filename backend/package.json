{
  "name": "isa-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run --test-timeout=30000",
    "test:watch": "vitest --test-timeout=30000",
    "test:coverage": "vitest run --coverage --test-timeout=30000",
    "lint": "eslint src",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:integration": "bash e2e/run-integration.sh",
    "eval:assistente": "tsx src/ai/eval/assistente-runner.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.32.0",
    "@microsoft/agents-activity": "1.10.2",
    "@microsoft/agents-hosting": "1.10.2",
    "@microsoft/agents-hosting-extensions-teams": "1.10.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@prisma/client": "^5.16.1",
    "@socket.io/postgres-adapter": "^0.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-holidays": "^3.30.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "openid-client": "^6.8.8",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "unpdf": "1.7.0",
    "winston": "^3.19.0",
    "yjs": "^13.6.33",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.7.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.14.11",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "prisma": "^5.16.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
