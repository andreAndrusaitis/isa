exports[`ticketFormCard > subcategoria comum pede título e descrição obrigatórios 1`] = `
{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "actions": [
    {
      "data": {
        "acao": "abrir",
        "subcategoryId": "sub-vpn",
      },
      "style": "positive",
      "title": "Abrir chamado",
      "type": "Action.Submit",
    },
    {
      "associatedInputs": "none",
      "data": {
        "acao": "categorias",
      },
      "title": "Voltar às categorias",
      "type": "Action.Submit",
    },
  ],
  "body": [
    {
      "size": "Medium",
      "text": "🔐 VPN",
      "type": "TextBlock",
      "weight": "Bolder",
      "wrap": true,
    },
    {
      "errorMessage": "Informe um título para o chamado",
      "id": "titulo",
      "isRequired": true,
      "label": "Título",
      "placeholder": "Resuma o problema ou pedido",
      "type": "Input.Text",
    },
    {
      "errorMessage": "Descreva o problema ou pedido",
      "id": "descricao",
      "isMultiline": true,
      "isRequired": true,
      "label": "Descrição",
      "placeholder": "Conte o que aconteceu, desde quando e quem é afetado",
      "type": "Input.Text",
    },
  ],
  "type": "AdaptiveCard",
  "version": "1.5",
}
`;

