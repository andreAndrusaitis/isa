exports[`agentReplyCard > traz número, trecho e campo de resposta com Responder 1`] = `
{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "actions": [
    {
      "data": {
        "acao": "responder",
        "ticketId": "t-1",
      },
      "style": "positive",
      "title": "Responder",
      "type": "Action.Submit",
    },
    {
      "title": "Abrir no portal",
      "type": "Action.OpenUrl",
      "url": "https://isa.example.com/chamados/t-1",
    },
  ],
  "body": [
    {
      "size": "Medium",
      "text": "Maria respondeu o chamado ISA-000123",
      "type": "TextBlock",
      "weight": "Bolder",
      "wrap": true,
    },
    {
      "isSubtle": true,
      "spacing": "None",
      "text": "VPN caiu",
      "type": "TextBlock",
      "wrap": true,
    },
    {
      "items": [
        {
          "text": "Olá! Pode testar de novo? Reiniciei o túnel.",
          "type": "TextBlock",
          "wrap": true,
        },
      ],
      "style": "emphasis",
      "type": "Container",
    },
    {
      "errorMessage": "Escreva a resposta antes de enviar",
      "id": "resposta",
      "isMultiline": true,
      "isRequired": true,
      "label": "Sua resposta",
      "placeholder": "Escreva aqui para responder ao analista",
      "type": "Input.Text",
    },
  ],
  "type": "AdaptiveCard",
  "version": "1.5",
}
`;

