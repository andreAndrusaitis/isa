      "data": {
        "acao": "confirmar",
        "tool": "abrir_chamado",
      },
      "style": "positive",
      "title": "Confirmar",
      "type": "Action.Submit",
    },
    {
      "data": {
        "acao": "cancelar",
        "tool": "abrir_chamado",
      },
      "style": "destructive",
      "title": "Cancelar",
      "type": "Action.Submit",
    },
  ],
  "body": [
    {
      "size": "Medium",
      "text": "Confirma esta ação?",
      "type": "TextBlock",
      "weight": "Bolder",
      "wrap": true,
    },
    {
      "text": "Abrir chamado "VPN caiu" em Infra › VPN",
      "type": "TextBlock",
      "wrap": true,
    },
    {
      "facts": [
        {
          "title": "Prioridade",
          "value": "Média",
        },
      ],
      "type": "FactSet",
    },
  ],
  "type": "AdaptiveCard",
  "version": "1.5",
}
`;

